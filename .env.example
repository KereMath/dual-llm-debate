# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Model Configuration
CLAUDE_MODEL=claude-sonnet-4-5-20250929
# Rolling alias survives model retirements; pin an exact id (e.g.
# gemini-3.5-flash) for reproducibility. Pro models need a paid tier;
# free-tier daily quotas are per model (~20 requests/day each).
GEMINI_MODEL=gemini-flash-latest
# Used when the primary model keeps failing (503 spikes, daily quota out)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# System Settings
MAX_ROUNDS=3
CONVERGENCE_THRESHOLD=0.95
QA_THRESHOLD=75
DEFAULT_RESEARCH_MODE=auto

# Output Paths
OUTPUT_DIR=./output
PDF_DIR=./output/pdfs
LATEX_DIR=./output/latex
LOG_DIR=./output/logs

# LaTeX Settings
LATEX_TIMEOUT=30
MAX_LATEX_RETRIES=3
MAX_PDF_REGENERATIONS=2
